{
  "expo": {
    "name": "GastroMatch",
    "slug": "Gastro-Match-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gastromatch-app-icon.png",
    "scheme": "gastromatchapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#28241f",
        "foregroundImage": "./assets/images/gastromatch-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/gastromatch-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gastromatch-logo.png",
          "imageWidth": 230,
          "resizeMode": "contain",
          "backgroundColor": "#faf3d4",
          "dark": {
            "backgroundColor": "#28241f"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
